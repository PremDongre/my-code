[Unit]
Description=Connect - app tier (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=connect
Group=connect
WorkingDirectory=/opt/connect
EnvironmentFile=/etc/connect.env
ExecStart=/opt/connect/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:8000 --timeout 60 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
