# =====  CONNECT - APP TIER settings  =====
# 1) Copy this file as  app.env   2) fill the values   3) upload it to S3 at  deploy/app.env
# Do not put spaces around "=" and do not write comments on the same line as a value.

# Any long random text (30+ characters). It MUST be the same on every app server.
SECRET_KEY=

# --- database (RDS MySQL endpoint is shown on the RDS page) ---
DB_HOST=connect-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=connect_db
DB_USER=admin
DB_PASSWORD=prem10012005

# --- file uploads (resumes, photos, certificates) go to this S3 bucket ---
S3_BUCKET=connect-prem-1234
AWS_REGION=ap-south-1

# --- first owner (PremTech) login. Used only the very first time to create the owner account ---
OWNER_EMAIL=prem.dongre1001@gmail.com
OWNER_PASSWORD=prem2005

# --- production switches ---
SEED_DEMO=0
APP_ENV=production
# 3 = public load balancer + Nginx + internal load balancer sit in front of the app (3-tier setup)
PROXY_HOPS=3
# keep 0 until HTTPS works on the load balancer, then change to 1
COOKIE_SECURE=0

# --- optional: real emails (Gmail app password or Amazon SES SMTP). Remove the # to use ---
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=yourmail@gmail.com
#SMTP_PASS=your-app-password
